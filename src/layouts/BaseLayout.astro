---
import '@/styles/globals.css';
import { siteConfig } from '@/lib/ffc-config';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noTemplate?: boolean;
  extraJsonLd?: object | object[];
}

const SITE_URL = siteConfig.website;
const DEFAULT_TITLE =
  `${siteConfig.name} Surat | Private Birthday Celebration Venue | Adajan, Surat`;
const DEFAULT_DESCRIPTION = siteConfig.description;
const DEFAULT_KEYWORDS = [
  'hivy',
  'hivy surat',
  'birthday surprise surat',
  'romantic cafe surat',
  'couples only cafe surat',
  'candlelight dinner surat',
  'birthday celebration venue surat',
  'anniversary celebration surat',
  'romantic proposal surat',
  'private dining surat',
  'romantic restaurant surat',
  'couple cafe adajan',
  'date night surat',
  'pre-wedding photoshoot surat',
  'surprise party surat',
  'romantic venue gujarat',
  'birthday surprise for boyfriend surat',
  'birthday surprise for girlfriend surat',
  'birthday surprise for husband surat',
  'birthday surprise for wife surat',
  'romantic dinner surat',
  'proposal setup surat',
  'valentines day surat',
  'private celebration venue surat',
];

const {
  title,
  description = DEFAULT_DESCRIPTION,
  keywords = DEFAULT_KEYWORDS,
  canonicalPath = '/',
  ogImage = '/images/og-image.jpg',
  ogImageAlt = `${siteConfig.name} - Best Romantic Celebrations in Surat`,
  noTemplate = false,
  extraJsonLd,
} = Astro.props;

const pageTitle = !title
  ? DEFAULT_TITLE
  : noTemplate
    ? title
    : `${title} | ${siteConfig.name} Surat`;
const canonicalUrl = `${SITE_URL}${canonicalPath === '/' ? '' : canonicalPath}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${SITE_URL}/#business`,
      name: siteConfig.name,
      alternateName: `${siteConfig.name} Surat`,
      description: siteConfig.description,
      url: SITE_URL,
      telephone: siteConfig.phone.replace(/\s+/g, '-'),
      email: siteConfig.email,
      priceRange: '₹₹₹',
      currenciesAccepted: 'INR',
      paymentAccepted: 'Cash, Credit Card, UPI, GPay, PhonePe',
      image: [
        `${SITE_URL}/hivy-images/6500/2.webp`,
        `${SITE_URL}/hivy-images/6300/2.webp`,
        `${SITE_URL}/hivy-images/5700/2.webp`,
      ],
      address: {
        '@type': 'PostalAddress',
        streetAddress: '252/253, 2nd Floor, The Boulevard, Near Pratham Circle, Galleria Street, Green City Road',
        addressLocality: 'Adajan, Surat',
        addressRegion: 'Gujarat',
        postalCode: '394510',
        addressCountry: 'IN',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: '21.1959',
        longitude: '72.7933',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '11:00',
          closes: '23:00',
        },
      ],
      sameAs: [
        siteConfig.socialLinks.instagram,
        siteConfig.socialLinks.facebook,
      ].filter(Boolean),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Birthday Celebration Packages',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Birthday Surprise Package',
              description: 'Private venue birthday celebration with decorations, cake, and romantic setup',
            },
            price: '4700',
            priceCurrency: 'INR',
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: siteConfig.name,
      description: siteConfig.tagline,
      publisher: { '@id': `${SITE_URL}/#business` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE_URL}/services?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: siteConfig.name,
      url: SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/images/hivy-logo.avif`,
        width: '375',
        height: '242',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: siteConfig.phone.replace(/\s+/g, '-'),
        contactType: 'reservations',
        areaServed: 'Surat',
        availableLanguage: ['English', 'Hindi', 'Gujarati'],
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE_URL}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services` },
        { '@type': 'ListItem', position: 3, name: 'Packages', item: `${SITE_URL}/packages` },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en-IN" class="font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#D97706" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={siteConfig.name} />
    <meta name="creator" content={siteConfig.name} />
    <meta name="publisher" content={siteConfig.name} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="category" content="Restaurant" />
    <meta name="classification" content="Romantic Celebration Venue" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <meta name="geo.region" content="IN-GJ" />
    <meta name="geo.placename" content="Surat" />
    <meta name="geo.position" content="22.3072;73.1812" />
    <meta name="ICBM" content="22.3072, 73.1812" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraJsonLd && (
      Array.isArray(extraJsonLd)
        ? extraJsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />
    )}
    <slot name="head" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored || 'light';
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased" data-whatsapp-number={siteConfig.whatsapp} data-site-city={siteConfig.city} data-site-name={siteConfig.name}>
    <slot />
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
